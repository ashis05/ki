{
  "name": "ki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ki: hand-tracked energy orb in the browser",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
