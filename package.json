    "@types/node": "^26.6.6",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
